{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "Replication Insights",
    "description_for_human": "Read-only simulated database replication insights and dashboard.",
    "contact_email": "publisher-email@example.com",
    "namespace": "replicatio",
    "functions": [],
    "runtimes": [
        {
            "type": "RemoteMCPServer",
            "spec": {
                "url": "${{MCP_PUBLIC_BASE_URL}}/mcp"
            },
            "run_for_functions": [
                "*"
            ],
            "auth": {
                "type": "OAuthPluginVault",
                "reference_id": "${{MCP_DA_AUTH_ID_REPLICATIO}}"
            }
        }
    ]
}
