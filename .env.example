# Copy to .env in the repository root. Values below must be supplied by your tenant.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# JSON array: API client GUID and the exact SSO audience when required.
ENTRA_ACCEPTED_AUDIENCES=[]
# Application ID URI from your Entra/API and Copilot SSO configuration.
ENTRA_IDENTIFIER_URI=
ENTRA_REQUIRED_SCOPE=Replication.Read
# Stable, reachable tunnel origin, with no /mcp path.
MCP_PUBLIC_BASE_URL=
